DATABASE_URL=sqlite:///./wetinnext.db
# Local-only demo sessions. Set false for any public deployment.
DEMO_MODE=true
# Supabase project URL enables JWT verification when demo mode is false.
SUPABASE_URL=
OPENAI_API_KEY=''
OPENAI_MODEL=''
LEARNER_SERVICE_URL=http://127.0.0.1:8001
CATALOG_SERVICE_URL=http://127.0.0.1:8002
MATCHING_SERVICE_URL=http://127.0.0.1:8003
# Set only after creating a real bot; the UI does not invent a bot username.
TELEGRAM_BOT_URL=
# Admin API key: generate a long random value and keep it server-side.
ADMIN_KEY=
# Catalogue service owns this separate SQLite database.
CATALOG_DATABASE=catalog.db

# Catalogue-owned automatic import loop; new records remain reviewable drafts.
AUTO_INGEST=true
SOURCE_REFRESH_HOURS=6

# Approved imports that pass deterministic gates can publish without manual review.
AUTO_PUBLISH=true
# Telegram is a separate worker; never put these credentials in VITE_ variables.
TELEGRAM_BOT_TOKEN=
TELEGRAM_SERVICE_SECRET=
TELEGRAM_STATE_DATABASE=telegram.db
GATEWAY_SERVICE_URL=http://127.0.0.1:8000

# Approved application name from https://apidoc.reliefweb.int/parameters
RELIEFWEB_APPNAME=

# Optional catalogue search. Leave blank for built-in typo-tolerant search.
# Keep these server-side; index privileges: read, index/write and auto_configure.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=wetinnext-catalogue

# Shared local PoC accounts; disabled with DEMO_MODE=false.
DEMO_SEED_PASSWORD=WetinNextDemo!2026
